<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>MY GALLERY</title>

    <link rel="stylesheet" href="style.css">
</head>

<body>

    <h1>IMPLEMENTATION JAVASCRIPT</h1>

    <div id="image">
        Hover over an image below to display here.
    </div>

    <div class="gallery">

        <img
            class="preview"
            src="images/flowers.jpg"
            alt="Flowers"
            onmouseover="upDate(this)"
            onmouseout="unDo()"
        >

        <img
            class="preview"
            src="images/river.jpg"
            alt="River"
            onmouseover="upDate(this)"
            onmouseout="unDo()"
        >

        <img
            class="preview"
            src="images/forest.jpg"
            alt="Forest"
            onmouseover="upDate(this)"
            onmouseout="unDo()"
        >

        <img
            class="preview"
            src="images/moutain.jpg"
            alt="Moutain"
            onmouseover="upDate(this)"
            onmouseout="unDo()"
        >

        <img
            class="preview"
            src="images/city.jpg"
            alt="City"
            onmouseover="upDate(this)"
            onmouseout="unDo()"
        >

        <img
            class="preview"
            src="images/beach.jpg"
            alt="Beach"
            onmouseover="upDate(this)"
            onmouseout="unDo()"
        >

    </div>

    <script src="script.js"></script>

</body>
</html>
