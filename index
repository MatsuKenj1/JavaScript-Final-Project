<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>MY GALLERY</title>

    <link rel="stylesheet" href="style.css">
</head>

<body>

    <h1>IMPLEMENTATION JAVASCRIPT</h1>

    <div id="image">
        Hover over an image below to display here.
    </div>

    <div class="gallery">

        <img
            class="preview"
            src="images/red magic 11 pro plus.png"
            alt="Red Magic 11 Pro Plus"
            onmouseover="upDate(this)"
            onmouseout="unDo()"
        >

        <img
            class="preview"
            src="images/red magic 11 pro.png"
            alt="Red Magic 11 Pro"
            onmouseover="upDate(this)"
            onmouseout="unDo()"
        >

        <img
            class="preview"
            src="images/redmi k90.png"
            alt="Redmi K90"
            onmouseover="upDate(this)"
            onmouseout="unDo()"
        >

        <img
            class="preview"
            src="images/redmi turbo 4 pro.jpg"
            alt="Redmi Turbo 4 Pro"
            onmouseover="upDate(this)"
            onmouseout="unDo()"
        >

        <img
            class="preview"
            src="images/rog phone 9.png"
            alt="Rog Phone 9"
            onmouseover="upDate(this)"
            onmouseout="unDo()"
        >

        <img
            class="preview"
            src="images/rog phone 8 pro.jpg"
            alt="Rog Phone 8 Pro"
            onmouseover="upDate(this)"
            onmouseout="unDo()"
        >

    </div>

    <script src="script.js"></script>

</body>
</html>
